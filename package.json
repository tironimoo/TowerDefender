{
  "name": "towerdefender",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tools tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/sim-runner/run.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "assets": "node tools/voxel-render/build.mjs",
    "balance": "tsx tools/sim-runner/alle.ts",
    "verlauf": "tsx tools/sim-runner/verlauf.ts",
    "app:sync": "npm run build && npx cap sync",
    "app:android": "npm run app:sync && npx cap open android",
    "app:ios": "npm run app:sync && npx cap open ios",
    "doku": "tsx tools/doku/startwerte.ts",
    "icons": "node tools/icons/build.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.3",
    "eslint": "^9.17.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
